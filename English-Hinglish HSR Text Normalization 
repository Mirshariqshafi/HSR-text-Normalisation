      "metadata": {
        "id": "J50lOrUNydjw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "trainer.save_model(\"./trained_hinglish_normalizer\")\n",
        "tokenizer.save_pretrained(\"./trained_hinglish_normalizer\")\n"
