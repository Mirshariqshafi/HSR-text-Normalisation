    {
      "cell_type": "code",
      "source": [
        "# ===== SAFE SETUP CELL =====\n",
        "import pandas as pd\n",
        "import torch\n",
        "from transformers import T5Tokenizer, T5ForConditionalGeneration\n",
        "\n",
        "# Load test data\n",
        "test_df = pd.read_csv(\"/content/test.tsv\", sep=\"\\t\")\n",
        "test_df = test_df.rename(columns={\n",
        "    test_df.columns[0]: \"raw_asr_text\",\n",
        "    test_df.columns[1]: \"normalized_text\"\n",
        "})\n",
        "\n",
        "# Load trained model\n",
        "model_path = \"./trained_hinglish_normalizer\"\n",
        "tokenizer = T5Tokenizer.from_pretrained(model_path)\n",
        "model = T5ForConditionalGeneration.from_pretrained(model_path)\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "model.to(device)\n",
        "model.eval()\n",
        "\n",
        "def predict(text):\n",
        "    inputs = tokenizer(\n",
        "        \"normalize: \" + text,\n",
        "        return_tensors=\"pt\",\n",
        "        truncation=True,\n",
        "        max_length=64\n",
        "    ).to(device)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = model.generate(inputs.input_ids, max_length=64)\n",
        "\n",
        "    return tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
        "# ===== END SAFE SETUP =====\n"
      ],
      "metadata": {
        "id": "a_Vw0yAp4kAV"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "measure performance"
      ],
      "metadata": {
        "id": "7WPwa91_10Bf"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from nltk.translate.bleu_score import sentence_bleu, SmoothingFunction\n",
        "from jiwer import wer\n",
        "\n",
        "smoothie = SmoothingFunction().method1\n",
        "\n",
        "bleu_scores = []\n",
        "wer_scores = []\n",
        "\n",
        "# ⚡ use only a small subset to avoid slowness\n",
        "sample_test = test_df.sample(n=50, random_state=42)\n",
        "\n",
        "for _, row in sample_test.iterrows():\n",
        "    pred = predict(row[\"raw_asr_text\"])\n",
        "    ref  = row[\"normalized_text\"]\n",
        "\n",
        "    bleu_scores.append(\n",
        "        sentence_bleu(\n",
        "            [ref.split()],\n",
        "            pred.split(),\n",
        "            smoothing_function=smoothie\n",
        "        )\n",
        "    )\n",
        "    wer_scores.append(wer(ref, pred))\n",
        "\n",
        "print(\"Avg BLEU:\", round(sum(bleu_scores) / len(bleu_scores), 3))\n",
        "print(\"Avg WER :\", round(sum(wer_scores) / len(wer_scores), 3))\n"
      ],
      "metadata": {
        "id": "xs0vyawc4Gnt"
      },
      "execution_count": null,
