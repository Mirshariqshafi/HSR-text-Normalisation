        "from nltk.translate.bleu_score import sentence_bleu, SmoothingFunction\n",
        "from jiwer import wer\n",
        "\n",
        "smoothie = SmoothingFunction().method1\n",
        "\n",
        "bleu_scores = []\n",
        "wer_scores = []\n",
        "\n",
        "# ⚡ use only a small subset to avoid slowness\n",
        "sample_test = test_df.sample(n=50, random_state=42)\n",
        "\n",
        "for _, row in sample_test.iterrows():\n",
        "    pred = predict(row[\"raw_asr_text\"])\n",
        "    ref  = row[\"normalized_text\"]\n",
        "\n",
        "    bleu_scores.append(\n",
        "        sentence_bleu(\n",
        "            [ref.split()],\n",
        "            pred.split(),\n",
        "            smoothing_function=smoothie\n",
        "        )\n",
        "    )\n",
        "    wer_scores.append(wer(ref, pred))\n",
        "\n",
        "print(\"Avg BLEU:\", round(sum(bleu_scores) / len(bleu_scores), 3))\n",
        "print(\"Avg WER :\", round(sum(wer_scores) / len(wer_scores), 3))\n"
      ],
