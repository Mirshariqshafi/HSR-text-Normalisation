      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "train_df = pd.read_csv(\"/content/train.tsv\", sep=\"\\t\")\n",
        "val_df   = pd.read_csv(\"/content/validation.tsv\", sep=\"\\t\")\n",
        "test_df  = pd.read_csv(\"/content/test.tsv\", sep=\"\\t\")\n"
      ],
