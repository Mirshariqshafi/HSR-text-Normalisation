      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "FIX COLUMN NAMES"
      ],
      "metadata": {
        "id": "_f9WqIfZx2qX"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def standardize_columns(df):\n",
        "    return df.rename(columns={\n",
        "\n",
        "        df.columns[0]: \"raw_asr_text\",\n",
        "        df.columns[1]: \"normalized_text\"\n",
        "    })\n",
        "\n",
        "train_df = standardize_columns(train_df)\n",
        "val_df   = standardize_columns(val_df)\n",
        "test_df  = standardize_columns(test_df)\n"
      ],
      "metadata": {
        "id": "NEm-p4cYmyvm"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(train_df.head())\n"
      ],
      "metadata": {
        "id": "kz9aCNn7m0-S"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "PREPARE DATA FOR TRAINING"
      ],
      "metadata": {
        "id": "5PPyhYZix87F"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from datasets import Dataset\n",
        "\n",
        "train_ds = Dataset.from_pandas(train_df)\n",
        "val_ds   = Dataset.from_pandas(val_df)\n",
        "test_ds  = Dataset.from_pandas(test_df)\n"
      ],
      "metadata": {
        "id": "QVjr9OZqm4MS"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "LOAD THE LANGUAGE MODEL"
      ],
      "metadata": {
        "id": "rcXsaKNfyAeq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from transformers import T5Tokenizer, T5ForConditionalGeneration\n",
        "\n",
        "model_name = \"t5-small\"\n",
        "\n",
        "tokenizer = T5Tokenizer.from_pretrained(model_name)\n",
        "model = T5ForConditionalGeneration.from_pretrained(model_name)\n"
      ],
      "metadata": {
        "id": "Q4KHrBFam7mf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "DEFINE HOW TEXT IS PREPARED"
      ],
      "metadata": {
        "id": "i5yKzk37yMx1"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "MAX_INPUT_LEN = 64\n",
        "MAX_TARGET_LEN = 64\n",
        "\n",
        "def preprocess(batch):\n",
        "    inputs = [\"normalize: \" + x for x in batch[\"raw_asr_text\"]]\n",
        "\n",
        "    model_inputs = tokenizer(\n",
        "        inputs,\n",
        "        max_length=MAX_INPUT_LEN,\n",
        "        truncation=True,\n",
        "        padding=\"max_length\"\n",
        "    )\n",
        "\n",
        "    labels = tokenizer(\n",
        "        text_target=batch[\"normalized_text\"],\n",
        "        max_length=MAX_TARGET_LEN,\n",
        "        truncation=True,\n",
        "        padding=\"max_length\"\n",
        "    )\n",
        "\n",
        "    model_inputs[\"labels\"] = labels[\"input_ids\"]\n",
        "    return model_inputs\n"
      ],
      "metadata": {
        "id": "eOsFqDK_nEoK"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "APPLY PREPARATION TO ALL DATA"
      ],
      "metadata": {
        "id": "efHIFqChyQcc"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "train_ds = train_ds.map(preprocess, batched=True)\n",
        "val_ds   = val_ds.map(preprocess, batched=True)\n",
        "test_ds  = test_ds.map(preprocess, batched=True)\n",
        "\n",
        "train_ds.set_format(type=\"torch\")\n",
        "val_ds.set_format(type=\"torch\")\n",
        "test_ds.set_format(type=\"torch\")\n"
      ],
      "metadata": {
        "id": "xh7UOqsGnHel"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "SET LEARNING RULES"
      ],
      "metadata": {
        "id": "B_FDIAzFyU4X"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from transformers import TrainingArguments\n",
        "\n",
        "training_args = TrainingArguments(\n",
        "    output_dir=\"./hinglish_normalizer\",\n",
        "    eval_strategy=\"epoch\",\n",
        "    learning_rate=3e-4,\n",
        "    per_device_train_batch_size=16,\n",
        "    per_device_eval_batch_size=16,\n",
        "    num_train_epochs=5,\n",
        "    weight_decay=0.01,\n",
        "    save_total_limit=2,\n",
        "    logging_steps=100,\n",
        "    report_to=\"none\",\n",
        "    fp16=True\n",
        ")\n"
      ],
      "metadata": {
        "id": "f-Kn5F_anM9v"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "CREATE THE TRAINING SYSTEM"
      ],
      "metadata": {
        "id": "qc9kYlVGyXfW"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from transformers import Trainer\n",
        "\n",
        "trainer = Trainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=train_ds,\n",
        "    eval_dataset=val_ds\n",
        ")"
      ],
      "metadata": {
        "id": "OELuh5gqnPYL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "TRAIN THE MODEL"
      ],
      "metadata": {
        "id": "ZXurIyhKyZ6B"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "trainer.train()\n"
      ],
      "metadata": {
        "id": "z3khJ5QSnW5O"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "SAVE THE TRAINED MODEL"
